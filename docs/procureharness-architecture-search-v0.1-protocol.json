  "search_procedure": {
    "candidate_representation": "code-represented workflow assembled from the frozen module grammar; every candidate config and code hash must be committed before execution",
    "candidate_generation": "enumeration, recombination, or meta-agent proposal is allowed only inside the frozen grammar; every proposal must record parent candidates and module deltas",
    "max_rounds": 3,
    "max_new_candidates_per_round": 6,
    "max_unique_candidates": 18,
    "screening": {
